# Copy this file to .env before deployment and adjust secrets/hosts.

BACKEND_PORT=8000
MYSQL_PORT=3306
MYSQL_DATABASE=metal_corrosion_db
DB_PASSWORD=change-me

SPRING_DATASOURCE_USERNAME=root
JWT_SECRET=replace-with-a-long-random-256-bit-secret
JWT_EXPIRATION=86400000

# The deployed second-version frontend currently points /corrosion to http://8.159.143.133:8000.
# Add any real frontend domain here as comma-separated origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:3000,http://8.159.143.133,http://8.159.143.133:3000
APP_STORAGE_IMAGE_LOCATION=file:/app/images/
